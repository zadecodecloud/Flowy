    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need access to media data for display in Notch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền truy cập dữ liệu phương tiện để hiển thị trên notch."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app requires Bluetooth access to check the status of devices."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng cần quyền truy cập Bluetooth để kiểm tra trạng thái thiết bị."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchFlow needs access to your calendar to display upcoming events in the notch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchFlow cần quyền truy cập lịch để hiển thị các sự kiện sắp tới trên notch."
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
